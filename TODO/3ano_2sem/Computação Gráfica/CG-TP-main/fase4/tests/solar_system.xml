<world> <!-- a world can have a camera, a window definition, and a single group -->
    <window width="2048" height="2048" />
    <camera> 
	    <position x="0" y="20" z="50" />
	    <lookAt x="0" y="0" z="0" />
	    <up x="0" y="1" z="0" /> <!-- optional, use these values as default-->
        <projection fov="60" near="1" far="1000" /> <!-- optional, use these values as default-->
    </camera>

    <lights>
        <light type="point" posx="0" posy="0" posz="0" />
    </lights>

    <group> 
        <group>
            <transform> 
                <scale x="2" y="2" z="2" />
            </transform>
            <models> 
                <model file="sphere_1_10_10.3d"> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
                    <texture file="sun.jpg"/>
                    <color>
                        <emissive R="255" G="255" B="255"/>
                    </color>    
                </model> 
            </models>
        </group>

        <!-- Mercúrio -->
        <group>
            <transform> 
                <rotate time="3" x="0" y="1" z="0"/>
                <translate x="3" y="0" z="0"/>
                <scale x="0.1" y="0.1" z="0.1" />
            </transform>
            <group>
                <transform>
                    <rotate time="10" x="0" y="1" z="0"/> <!-- rotação própria -->
                </transform>
                <models> 
                    <model file="sphere_1_10_10.3d"> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
                        <texture file="mercury.jpg"/>
                    </model>
                </models>
            </group>
        </group>

        <!-- Vénus -->
        <group>
            <transform> 
                <rotate time="8" x="0" y="-1" z="0"/>
                <translate x="6" y="0" z="0"/>
                <scale x="0.5" y="0.5" z="0.5" />
            </transform>
            <group>
                <transform>
                    <rotate time="2" x="0" y="1" z="0"/>
                </transform>
                <models> 
                    <model file="sphere_1_10_10.3d"> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
                        <texture file="venus.jpg"/>
                    </model>
                </models>
