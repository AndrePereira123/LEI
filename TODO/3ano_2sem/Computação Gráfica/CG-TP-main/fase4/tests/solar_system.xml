                <!-- Lua -->
                <group>
                    <transform>
                        <rotate time="1" x="0" y="1" z="0"/>
                        <translate x="0" y="0" z="-2"/>
                        <scale x="0.153" y="0.153" z="0.153" />
                    </transform>
                    <models>
                        <model file="sphere_1_10_10.3d"> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
                            <texture file="moon.jpg"/>
                        </model>
                    </models>
                </group>
            </group>
        </group>

        <!-- Marte -->
        <group>
            <transform> 
                <rotate time="23" x="0" y="1" z="0"/>
