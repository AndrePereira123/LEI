<world> <!-- a world can have a camera, a window definition, and a single group -->
    <window width="2048" height="2048" />
    <camera> 
	    <position x="-6" y="6" z="15" />
	    <lookAt x="9" y="0" z="0" />
	    <up x="0" y="1" z="0" /> <!-- optional, use these values as default-->
        <projection fov="60" near="1" far="1000" /> <!-- optional, use these values as default-->
    </camera>

    <group> 
        <!-- Sol -->
        <group>
            <transform> 
                <scale x="2" y="2" z="2" />
            </transform>
            <models> 
                <model file="sphere_1_10_10.3d" /> <!-- generator sphere 1 10 10 sphere_1_10_10.3d -->
            </models>
        </group>

        <!-- Mercúrio -->
        <group>
            <transform> 
                <translate x="3" y="0" z="0"/>
